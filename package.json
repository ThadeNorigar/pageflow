{
  "name": "pageflow",
  "version": "0.2.0",
  "private": true,
  "description": "Atlassian Forge app for content import/export with Confluence",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:frontend": "npm run build --workspace=src/frontend",
    "build:all": "npm run build && npm run build:frontend",
    "test": "jest --passWithNoTests",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,css}'"
  },
  "workspaces": [
    "src/frontend"
  ],
  "dependencies": {
    "@forge/api": "^4.1.0",
    "@forge/resolver": "^1.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0"
  }
}
